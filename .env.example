# Main application database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/devshelf?schema=public"

# Prisma migration shadow database
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/devshelf_shadow?schema=public"

# Central authentication secret for Auth.js sessions and JWT encryption.
# Required in production (must be at least 32 characters long).
# You must generate your own cryptographically secure random secret locally.
# Example generation command:
#   openssl rand -base64 33
# Do not commit your actual production secret to version control.
AUTH_SECRET=""
